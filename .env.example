JIRA_EMAIL=
JIRA_TOKEN=
JIRA_DOMAIN=your-domain.atlassian.net
JIRA_PROJECT=PROJ
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BASE_TOKEN=
LARK_TABLE_ID=
WEBHOOK_SECRET_JIRA=

# Multi-project: JIRA_PROJECT, LARK_BASE_TOKEN and LARK_TABLE_ID (and the
# optional ASSIGNEE_MAP / DEFAULT_SYNC_TYPES below) only seed project #1 the
# first time the registry is bootstrapped. Further projects are created from
# the dashboard ("+ New project") and stored in Supabase `sync_projects`.

# --- Workspace profile (all optional) ---------------------------------------
# Leave these unset to keep the original workspace's values. Set them to point
# this service at a different Jira site or Lark tenant without a code change.

# Jira custom field IDs. They differ per Jira site; look them up at
# /api/jira-fields on the dashboard host.
# JIRA_FIELD_START_DATE=customfield_10015
# JIRA_FIELD_STORY_POINTS=customfield_10016
# JIRA_FIELD_ACTUAL_START=customfield_10175
# JIRA_FIELD_ACTUAL_END=customfield_10176
# JIRA_FIELD_SPRINT=customfield_10020

# Jira display name -> Lark Assignee option, as one line of JSON (seeds project #1 only).
# ASSIGNEE_MAP={"Jane Doe": "Jane", "John Roe": "John"}

# Issue types synced before any are chosen on the dashboard (seeds project #1 only).
# DEFAULT_SYNC_TYPES=["Epic", "Story", "Task"]

# Lark (larksuite.com) or Feishu (https://open.feishu.cn/open-apis).
# LARK_API_BASE=https://open.larksuite.com/open-apis
# open_id of the bot that /auth/callback adds as editor on the Base.
# LARK_BOT_OPEN_ID=
# Public address of this service. Its /auth/callback must be registered as a
# redirect URL in the Lark app.
# PUBLIC_URL=https://jira-lark-webhook.onrender.com

# UTC offset used for history timestamps, the daily Lark call counter and
# reconcile's Jira "updated since" query. Must match the Jira site timezone.
# TZ_OFFSET_HOURS=7
